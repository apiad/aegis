    async def arm(
        self,
        *,
        definition: str | None = ...,
        id: str | None = ...,
        token: str | None = ...,
        args: dict[str, Any] = ...,
        run: str | None = ...,
        dock: str | None = ...,
    ) -> Any:
        """Arm a workflow: a YAML tree in which every node says, in one sentence for the person, what it does. It is linted, drawn as a card under this call, and runs only when a person approves it there. Use it for work that needs coordination (many agents, checks, gates); a linear plan_update is for work you do yourself. With run, arms a stopped or failed run of yours again: what finished keeps its result, the rest runs after a new approval; a definition given with it may change only what an edit may. With dock, the card also opens beside the transcript, as artifact_send's page does."""
    async def ask(self, *, question: str) -> Any:
        """As a workflow node, ask the main agent a question you cannot go on without, then end your turn: the answer arrives as your next message. It never reaches a person."""
    async def delete(self, *, id: str) -> Any:
        """Delete a saved workflow from the project. A built-in one cannot be deleted. A schedule that fires it pauses."""
    async def edit(self, *, run: str, definition: str) -> Any:
        """Change your running workflow: send the whole definition with the same ids. Steps that started stay as they are, except a failed or stopped one, which the change retries. The person approves a diff of the steps' sentences on a card under this call; until then the run goes on, and steps the change touches wait for the answer."""
    async def edit_apply(self, *, run: str, v: int) -> Any:
        """workflow.edit.apply"""
    async def edit_reject(self, *, run: str, v: int) -> Any:
        """workflow.edit.reject"""
    async def gate(self, *, run: str, node: str, go: bool, answer: str = ...) -> Any:
        """workflow.gate"""
    async def gate_delegate(self, *, run: str, node: str) -> Any:
        """workflow.gate.delegate"""
    async def lint(self, *, definition: str) -> Any:
        """Check a workflow without arming it: every error with its YAML path. Arming runs the same check."""
    async def list(self) -> Any:
        """The saved workflows a person can run with /workflow <id> <text>: built in and the project's, each with its title, args schema, version, who saved it, and what is wrong with it if it does not lint."""
    async def note(self, *, run: str, text: str) -> Any:
        """Write one line into your workflow's story, the card the person reads: why you answered or decided as you did."""
    async def output(
        self, *, name: str, value: Any, summary: str, node: str | None = ...
    ) -> Any:
        """Give an early output while your node keeps working, as a workflow node: a step waiting on it starts now. Each name once. Your first message names the outputs other steps wait on."""
    async def read(self, *, id: str) -> Any:
        """A saved workflow for Settings → Workflows: its file's text, to export, and its steps as the card draws them. A person's: an agent reads the file itself."""
    async def reject(self, *, run: str) -> Any:
        """workflow.reject"""
    async def result(self, *, value: Any, summary: str, node: str | None = ...) -> Any:
        """Report your node's result, as a workflow node: a value matching the node's schema and a one-sentence summary for the person. Your turn should end right after. As a judge, value is {pass, why}."""
    async def save(self, *, definition: str) -> Any:
        """Save a workflow into the project, as .aegis/workflows/<id>.yaml, so a person can run it with /workflow <id> <text> and a schedule can fire it. Its generated ids are written into the file, so later edits keep them. Saving needs no approval and replaces a saved one with the same id; running it still does, unless a person launched it."""
    async def see(self, *, run: str, node: str) -> Any:
        """workflow.see"""
    async def status(self, *, run: str) -> Any:
        """A run's tree: each node's state, session, times and summary, and the story so far."""
    async def stop(self, *, run: str, node: str | None = ...) -> Any:
        """Stop a workflow you armed. Its running nodes are interrupted and their sessions unlocked, so they can be read and talked to. With node, stop only that running step: it fails, the run goes on, and you retry, skip or change it with workflow_answer or workflow_edit."""
